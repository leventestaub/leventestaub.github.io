---
// One case-study figure (BRIEF.md figure kinds). No captions (site rule): alt carries the description,
// charts carry their own title/axes. Charts are inlined so the page fonts apply to SVG text.
import fs from 'node:fs';
import path from 'node:path';
import type { Figure } from '../data/work';
interface Props { f: Figure }
const { f } = Astro.props;
const small = (src: string) => src.replace(/\.webp$/, '-1200.webp');
const phone = (src: string) => src.replace(/\.webp$/, '-720.webp');   // tools/cover_sizes.mjs
const set = (src: string) => exists(small(src)) ? `${exists(phone(src)) ? `${phone(src)} 720w, ` : ''}${small(src)} 1200w, ${src} 2400w` : undefined;
const sizes = '(max-width: 820px) 92vw, 60vw';   // figures sit inside the wrap padding on a phone
const exists = (src: string) => fs.existsSync(path.join(process.cwd(), 'public', src));
let svg = '';
if (f.kind === 'chart') {
  const raw = fs.readFileSync(path.join(process.cwd(), 'public', f.src), 'utf8');
  // strip XML prolog/doctype and fixed size so the SVG scales with its column; keep viewBox
  svg = raw.replace(/<\?xml[^>]*>|<!DOCTYPE[^>]*>/g, '')
    .replace(/<svg([^>]*?)\swidth="[^"]*"/, '<svg$1').replace(/<svg([^>]*?)\sheight="[^"]*"/, '<svg$1')
    .replace('<svg', `<svg role="img" aria-label="${f.alt.replace(/"/g, '&quot;')}"`);
}
const ratio = (r?: string) => (r ?? '16:9').replace(':', ' / ');
---
{f.kind === 'chart' && <figure class:list={['fig', 'fig-chart', { wide: f.wide }]} set:html={svg} />}

{f.kind === 'image' && (
  <figure class:list={['fig', 'fig-img', { wide: f.wide }]} style={`aspect-ratio:${ratio(f.ratio)}`}>
    <img src={f.src} srcset={set(f.src)} sizes={sizes} alt={f.alt} loading="lazy" decoding="async" />
  </figure>
)}

{f.kind === 'compare' && (
  <figure class:list={['fig', 'fig-cmp', { wide: f.wide }]} style={`aspect-ratio:${ratio(f.ratio)}`} data-compare>
    <img src={f.before} srcset={set(f.before)} sizes={sizes} alt={f.alt} loading="lazy" decoding="async" />
    <img class="cmp-after" src={f.after} srcset={set(f.after)} sizes={sizes} alt="" loading="lazy" decoding="async" />
    <span class="cmp-bar" aria-hidden="true"></span>
    <span class="cmp-lab mono l" aria-hidden="true">{f.labels[0]}</span>
    <span class="cmp-lab mono r" aria-hidden="true">{f.labels[1]}</span>
    <input type="range" min="0" max="100" value="50" aria-label={`Slide between ${f.labels[0]} and ${f.labels[1]}`} />
  </figure>
)}

{f.kind === 'video' && (
  <figure class:list={['fig', 'fig-vid', { wide: f.wide, phone: f.phone }]} style={`aspect-ratio:${ratio(f.ratio)}${f.phone ? `;background:${f.phone}` : ''}`}>
    <video src={f.src} poster={f.poster} muted loop playsinline preload="none" aria-label={f.alt} data-autoplay></video>
  </figure>
)}

{f.kind === 'table' && (
  <div class:list={['fig', 'fig-table', { wide: f.wide }]}>
    <table class="mono">
      <thead><tr>{f.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
      <tbody>{f.rows.map((r) => <tr>{r.map((c, i) => (i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>))}</tr>)}</tbody>
    </table>
  </div>
)}

<style>
  .fig { margin: var(--s4) 0 0; max-width: 760px; }
  .fig.wide { max-width: none; }
  .fig-chart :global(svg) { display: block; width: 100%; height: auto; overflow: visible; }
  .fig-chart :global(svg text) { fill: var(--ink); }
  .fig-img, .fig-cmp, .fig-vid { position: relative; overflow: hidden; background: var(--paper-2); }
  .fig img, .fig video { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* a portrait phone recording, shown whole and never upscaled: the screen sits centred on the band */
  .fig-vid.phone { display: grid; place-items: center; padding: 5% 0; }
  .fig-vid.phone video { width: auto; height: 100%; max-height: 844px; aspect-ratio: 390 / 844; object-fit: contain; border-radius: 14px; }
  .fig-img img { transition: transform .6s var(--ease, ease); }

  .fig-cmp > img { position: absolute; inset: 0; }
  .cmp-after { clip-path: inset(0 0 0 var(--x, 50%)); }
  .cmp-bar { position: absolute; top: 0; bottom: 0; left: var(--x, 50%); width: 1.5px; background: var(--signal); pointer-events: none; }
  .cmp-bar::after { content: ''; position: absolute; top: 50%; left: -7px; width: 15px; height: 15px; margin-top: -7px; background: var(--signal); }
  .cmp-lab { position: absolute; bottom: 10px; padding: 3px 8px; background: var(--ink); color: var(--paper); font-size: 12px; pointer-events: none; }
  .cmp-lab.l { left: 10px; } .cmp-lab.r { right: 10px; }
  .fig-cmp input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; }
  .fig-cmp:has(input:focus-visible) { outline: 2px solid var(--ink); outline-offset: 3px; }

  .fig-table { overflow-x: auto; }
  .fig-table table { width: 100%; border-collapse: collapse; font-size: 14px; font-variant-numeric: tabular-nums; }
  .fig-table th, .fig-table td { text-align: left; padding: 10px 12px 10px 0; border-top: 1px solid var(--line); font-weight: 400; }
  .fig-table thead th { color: var(--mute); border-top: 0; }
  .fig-table tbody tr:last-child > * { border-bottom: 1px solid var(--line); }
</style>

<script>
  // Delegated once at document level, so it survives ClientRouter swaps.
  document.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.closest?.('[data-compare]')) (t.parentElement as HTMLElement).style.setProperty('--x', `${t.value}%`);
  });
  const vids = () => {
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((v) => {
      if (still) { v.controls = true; return; }
      new IntersectionObserver(([en]) => { en.isIntersecting ? v.play().catch(() => {}) : v.pause(); }, { threshold: .25 }).observe(v);
    });
  };
  document.addEventListener('astro:page-load', vids);
</script>
