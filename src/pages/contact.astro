---
import Base from '../layouts/Base.astro';
// Contact (sitemap.md): copy-email (Dual Scramble), CV, GitHub, LinkedIn, availability. No form, no FAQ, no phone.
// Email = the professional address in master-profile.md. Copy is placeholder.
const email = 'levente.staub@gmail.com';
const rows: { k: string; v: string; href?: string; note?: string }[] = [
  { k: 'GitHub', v: 'github.com/leventestaub', href: 'https://github.com/leventestaub' },
  { k: 'LinkedIn', v: 'linkedin.com/in/leventestaub', href: 'https://www.linkedin.com/in/leventestaub/' },
  // CV SLOT: the CV PDF carries a phone number; a web version without it goes here once the user decides.
  { k: 'CV', v: 'PDF on request', href: `mailto:${email}?subject=CV%20request` },
  { k: 'Based in', v: 'Breda, the Netherlands', note: 'English; Dutch is in progress' },
];
---
<Base title="Contact, Levente Staub">
  <section class="light ground ct">
    <div class="grid">
      <div class="rail"><span class="tick mono" data-tick>Contact</span></div>
      <div class="main">
        <h1 class="display ct-h" data-chars>Get in touch</h1>
        <p class="lead ct-lead">Looking for a graduation internship in computer vision, ML engineering or MLOps, February to June 2027.</p>
      </div>
    </div>

    <div class="grid ct-mail">
      <div class="rail"><span class="mono muted">Email</span></div>
      <div class="main mail-row">
        <a class="mail h2 link" href={`mailto:${email}`}>{email}</a>
        <button class="btn copy" type="button" data-copy={email} aria-live="polite"><span data-copy-label>Copy email</span></button>
      </div>
    </div>

    <dl class="ct-rows">
      {rows.map((r) => (
        <div class="grid crow">
          <dt class="rail mono muted">{r.k}</dt>
          <dd class="main">
            {r.href ? <a class="link crow-v" href={r.href}>{r.v}</a> : <span class="crow-v">{r.v}</span>}
            {r.note && <span class="mono muted crow-n">{r.note}</span>}
          </dd>
        </div>
      ))}
      <div class="grid crow">
        <dt class="rail mono muted">Availability</dt>
        <dd class="main"><span class="tick signal mono" data-tick>Feb – Jun 2027, graduation internship</span></dd>
      </div>
    </dl>
  </section>
</Base>

<style>
  .ct { min-height: 100vh; padding: 150px 0 var(--s7); }
  .ct-h { font-size: var(--t-hero); }
  .ct-lead { margin-top: var(--s4); max-width: 34ch; }
  .ct-mail { margin-top: var(--s6); align-items: baseline; padding-block: var(--s3); border-top: 1px solid var(--ink); }
  .mail-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s2) var(--s3); }
  .mail { font-size: clamp(28px, 3.6vw, 60px); word-break: break-all; }
  .copy { min-width: 9.5em; justify-content: center; font-family: var(--mono); font-size: var(--t-mono); }
  .ct-rows { margin: 0; }
  .crow { padding-block: 18px; border-top: 1px solid var(--line); align-items: baseline; }
  .crow:last-child { border-bottom: 1px solid var(--line); }
  .crow dd { margin: 0; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px var(--s3); }
  .crow-v { font: 500 var(--t-h3)/1.15 var(--sans); letter-spacing: -.02em; }
  @media (max-width: 820px) {
    .ct { padding-top: 110px; }
    .ct-mail .rail, .crow dt { grid-column: 1 / -1; margin-bottom: 6px; }
    .ct-mail .main, .crow dd { grid-column: 1 / -1; }
  }
</style>
