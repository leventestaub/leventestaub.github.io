---
import Base from '../layouts/Base.astro';
import { work } from '../data/work';
// 404: says what happened and where to go. Lists the case studies so a stale link still lands somewhere useful.
---
<Base title="Page not found, Levente Staub" description="This page does not exist.">
  <section class="light ground nf">
    <div class="grid">
      <div class="rail"><span class="tick mono" data-tick>404</span></div>
      <div class="main">
        <h1 class="display nf-h" data-chars>Page not found</h1>
        <p class="lead nf-lead">This address does not exist, or the page has moved. The work and the contact details are below.</p>
        <p class="nf-cta"><a class="btn" href="/work">See the work</a> <a class="btn ghost" href="/">Home</a></p>
      </div>
    </div>
    <div class="grid nf-list">
      <div class="rail"><span class="mono muted">Case studies</span></div>
      <ul class="main">
        {work.map((p) => <li><a class="link h3" href={`/work/${p.slug}`}>{p.title}</a><span class="mono muted">{p.year}</span></li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .nf { padding: 150px 0 var(--s7); min-height: 100svh; }
  .nf-h { font-size: var(--t-hero); }
  .nf-lead { margin-top: var(--s4); max-width: 36ch; }
  .nf-cta { margin-top: var(--s4); display: flex; gap: var(--s2); flex-wrap: wrap; }
  .nf-list { margin-top: var(--s6); }
  .nf-list ul { list-style: none; margin: 0; padding: 0; }
  .nf-list li { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s2); padding: 14px 0; border-top: 1px solid var(--line); }
  .nf-list li:last-child { border-bottom: 1px solid var(--line); }
  @media (max-width: 820px) { .nf { padding-top: 110px; } }
</style>
