---
import Base from '../layouts/Base.astro';
// About (sitemap.md). Copy is placeholder; facts only from project-grad/profile/master-profile.md. No photo.
// Motion: Paragraph Indent intro + Alternating Timeline (motion.md).
const timeline = [
  { when: '2024', what: 'BSc Applied Data Science & AI', where: 'Breda University of Applied Sciences', note: 'Expected 2027.' },
  { when: 'Jun 2025 – Jun 2026', what: 'AI Engineer Intern (part-time)', where: 'AIGENTIC Compliance', note: 'A RAG assistant on a self-hosted Llama 3 model, containerised and deployed on GCP Cloud Run.' },
  { when: 'Dec 2025 – Apr 2026', what: 'Root phenotyping', where: 'University project', note: 'U-Net segmentation and root tracing on Petri-dish images.' },
  { when: 'Mar 2026', what: 'Pastaio', where: 'Own project', note: 'An Italian cooking app around a tool-using LLM agent.' },
  { when: 'Apr – Jun 2026', what: 'Sentify', where: 'Group project', note: 'Retraining, registration gate and rollout for an emotion classifier.' },
  { when: 'Jul 2026', what: 'Project Assistant (part-time)', where: "B'ROBOTICS", note: 'Research on robotics companies for a convention.' },
  { when: 'Sep 2026', what: 'Pre-Master Data Science & AI', where: 'Eindhoven University of Technology', note: '' },
  { when: 'Feb 2027', what: 'Graduation internship', where: 'Open', note: 'Computer vision, ML engineering or MLOps.' },
];
const skills: [string, string][] = [
  ['Languages', 'Python, SQL, TypeScript'],
  ['Machine learning', 'PyTorch, Hugging Face Transformers, TensorFlow/Keras, scikit-learn, XGBoost, Optuna, Stable-Baselines3'],
  ['Computer vision', 'U-Net segmentation, OpenCV, scikit-image'],
  ['LLM and speech', 'Tool-using agents (Groq, Ollama), Whisper'],
  ['MLOps', 'Docker, MLflow, Azure ML, GitHub Actions, pytest, W&B, ClearML, Evidently'],
  ['Apps and data', 'FastAPI, Streamlit, PostgreSQL, SQLite, pandas'],
];
const langs: [string, string][] = [['Hungarian', 'Native'], ['English', 'C1'], ['Dutch', 'Learning'], ['German', 'Beginner']];
---
<Base title="About, Levente Staub">
  <section class="light ground ab-hero">
    <div class="grid">
      <div class="rail"><span class="tick mono" data-tick>About</span></div>
      <div class="main"><h1 class="display ab-h" data-chars>About</h1></div>
    </div>
    <div class="grid ab-intro">
      <p class="indent" data-indent>
        <span class="indent-label mono muted" aria-hidden="true">Breda, NL</span>
        <span data-reveal>I train machine-learning models and build the parts around them: data preparation, evaluation, an API that serves the model and a pipeline that retrains it. So far that has been in study and client projects. Final-year Applied Data Science and AI student at BUas, looking for a graduation internship from February 2027.</span>
      </p>
    </div>
  </section>

  <section class="light ground ab-focus">
    <div class="grid">
      <div class="rail"><span class="tick mono" data-tick>Focus</span></div>
      <ul class="main focus">
        <li><h2 class="h3">Computer vision</h2><p class="body muted">Segmentation and measurement on real images, from labels to numbers someone can use.</p></li>
        <li><h2 class="h3">ML engineering</h2><p class="body muted">Models as software: tested, versioned, packaged and served.</p></li>
        <li><h2 class="h3">MLOps</h2><p class="body muted">Retraining, gates, rollout and monitoring, built and tested in course and client projects.</p></li>
      </ul>
    </div>
  </section>

  <section class="light ground ab-time">
    <div class="grid">
      <div class="rail"><span class="tick mono" data-tick>Timeline</span></div>
    </div>
    <ol class="tline" data-timeline>
      <span class="spine" aria-hidden="true"></span>
      {timeline.map((t, i) => (
        <li class:list={['titem', i % 2 ? 'r' : 'l']} data-side={i % 2 ? 'r' : 'l'}>
          <span class="t-dot" aria-hidden="true"></span>
          <p class="mono muted t-when">{t.when}</p>
          <h3 class="h3 t-what">{t.what}</h3>
          <p class="mono t-where">{t.where}</p>
          {t.note && <p class="body muted t-note">{t.note}</p>}
        </li>
      ))}
    </ol>
  </section>

  <section class="light ground ab-skills">
    <div class="grid">
      <div class="rail"><span class="tick mono" data-tick>Tools</span></div>
      <dl class="main kv">
        {skills.map(([k, v]) => <div><dt class="mono muted">{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
    <div class="grid sk-langs">
      <div class="rail"><span class="tick mono" data-tick>Languages</span></div>
      <dl class="main langs">
        {langs.map(([k, v]) => <div><dt class="h3">{k}</dt><dd class="mono muted">{v}</dd></div>)}
      </dl>
    </div>
    <div class="grid ab-cta">
      <div class="main"><a class="btn" href="/contact">Get in touch</a> <a class="btn ghost" href="/work">See the work</a></div>
    </div>
  </section>
</Base>

<style>
  .ab-hero { padding: 150px 0 var(--s6); }
  .ab-h { font-size: var(--t-hero); }
  .ab-intro { margin-top: var(--s6); }
  /* Paragraph Indent: the first line starts at the main column; the label sits in the gap */
  .indent { grid-column: 1 / -1; position: relative; margin: 0; font: 500 var(--t-state)/1.18 var(--sans); letter-spacing: -.02em;
    text-indent: calc((100% - 11 * var(--gutter)) / 12 * 4 + 4 * var(--gutter)); max-width: none; }
  .indent :global([data-reveal] *) { text-indent: 0; }
  .indent-label { position: absolute; left: 0; top: .55em; text-indent: 0; }

  .ab-focus { padding: var(--s5) 0 var(--s6); }
  .focus { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gutter); }
  .focus li { border-top: 1px solid var(--line); padding-top: var(--s2); display: grid; gap: var(--s2); align-content: start; }
  .focus .body { margin: 0; max-width: 30ch; }

  .ab-time { padding: var(--s5) 0 var(--s6); }
  .tline { position: relative; list-style: none; margin: var(--s4) 0 0; padding: 0 var(--margin); display: grid; grid-template-columns: 1fr 1fr; column-gap: var(--s6); }
  .spine { position: absolute; left: 50%; top: 0; bottom: 0; width: 1.5px; background: var(--ink); transform-origin: 50% 0; }
  .titem { position: relative; padding: var(--s3) 0; display: grid; gap: 6px; align-content: start; }
  .titem.l { grid-column: 1; text-align: right; justify-items: end; }
  .titem.r { grid-column: 2; margin-top: var(--s6); }
  .t-dot { position: absolute; top: calc(var(--s3) + 4px); width: 11px; height: 11px; background: var(--paper); box-shadow: inset 0 0 0 1.5px var(--ink); }
  .titem.l .t-dot { right: calc(-1 * var(--s6) / 2 - 5px); }
  .titem.r .t-dot { left: calc(-1 * var(--s6) / 2 - 5px); }
  .titem:last-child .t-dot { background: var(--signal); box-shadow: none; }
  .t-what, .t-where, .t-when, .t-note { margin: 0; }
  .t-note { max-width: 40ch; }

  .ab-skills { padding: var(--s5) 0 var(--s7); }
  .kv { margin: 0; display: grid; }
  .kv div { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: var(--gutter); padding: 14px 0; border-top: 1px solid var(--line); }
  .kv dd { margin: 0; font-size: 19px; line-height: 1.4; }
  .sk-langs { margin-top: var(--s6); }
  .langs { margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--gutter); }
  .langs div { border-top: 1px solid var(--line); padding-top: var(--s2); display: grid; gap: 6px; }
  .langs dd { margin: 0; }
  .ab-cta { margin-top: var(--s6); }
  .ab-cta .main { display: flex; gap: var(--s2); flex-wrap: wrap; }

  @media (max-width: 820px) {
    .ab-hero { padding-top: 110px; }
    .indent { text-indent: 0; padding-top: 2em; }
    .indent-label { top: 0; }
    .focus { grid-template-columns: 1fr; }
    .tline { grid-template-columns: 1fr; padding-left: calc(var(--margin) + 28px); }
    .spine { left: calc(var(--margin) + 5px); }
    .titem.l, .titem.r { grid-column: 1; text-align: left; justify-items: start; margin-top: 0; }
    .titem.l .t-dot, .titem.r .t-dot { left: -28px; right: auto; }
    .kv div { grid-template-columns: 1fr; gap: 4px; }
    .langs { grid-template-columns: 1fr 1fr; row-gap: var(--s3); }
  }
</style>
