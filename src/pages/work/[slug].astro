---
import Base from '../../layouts/Base.astro';
import { work, type Project } from '../../data/work';
import CaseFigure from '../../components/CaseFigure.astro';
// Case-study template (sitemap.md). Signature: Breakout Media cover. Copy is placeholder; the user writes the final wording.

export function getStaticPaths() {
  return work.map((p, i) => ({ params: { slug: p.slug }, props: { p, next: work[(i + 1) % work.length] } }));
}
interface Props { p: Project; next: Project }
const { p, next } = Astro.props;
const fmt = (m: Project['metrics'][number]) => `${m.prefix ?? ''}${m.value.toFixed(m.decimals)}${m.suffix ?? ''}`;
---
<Base title={`${p.title}, Levente Staub`} description={p.line}>
  <!-- 1 · hero: title, one line, result chip, metadata row -->
  <section class="case-hero light ground">
    <div class="grid">
      <div class="rail case-rail">
        <a class="link mono back" href="/work">All work</a>
        <span class="tick mono" data-tick>Case study, {p.year}</span>
      </div>
      <div class="main">
        <h1 class="display case-h" data-chars>{p.title}</h1>
        <p class="lead case-line">{p.line}</p>
        <p class="mono chip"><span class="tick signal" data-tick>{p.result}</span></p>
      </div>
    </div>
    <dl class="grid meta mono">
      {p.meta.map(([k, v]) => <div><dt class="muted">{k}</dt><dd>{v}</dd></div>)}
    </dl>
  </section>

  <!-- 2 · cover: Breakout Media, grows from the main column to full bleed (scrubbed). Morph target of the home card. -->
  <section class="cover-band light" aria-label="Cover">
    <figure class="case-cover dimg" data-breakout style={`view-transition-name: cover-${p.slug}`}>
      <!-- COVER SLOT: re-rendered project output (assets.md). Procedural stand-in until then. -->
      <img src={p.coverWide} alt="" width="2560" height="1440" decoding="async" fetchpriority="high" />
    </figure>
  </section>

  <!-- 3 · body: sticky chapter rail (Feature Rail) + chapters -->
  <section class="case-body light ground">
    <div class="grid">
      <nav class="rail chapters" aria-label="Chapters" data-rail>
        <ol class="mono">
          {p.chapters.map((c) => <li><a href={`#${c.id}`} data-chapter-link={c.id}>{c.title}</a></li>)}
        </ol>
      </nav>
      <div class="main">
        {p.chapters.map((c) => (
          <section class="chapter" id={c.id} data-chapter aria-labelledby={`${c.id}-h`}>
            <h2 class="h2" id={`${c.id}-h`}>{c.title}</h2>
            {c.body.map((b) => <p class="body">{b}</p>)}
            {c.figures?.map((f) => <CaseFigure f={f} />)}

            {c.id === 'approach' && (
              <div class="pipe mono" data-pipe style={`--n:${p.pipeline.length}`}>
                <span class="pipe-line" aria-hidden="true"></span>
                <ol>
                {p.pipeline.map((s, i) => <li data-step><span class="pipe-dot"></span><span class="muted">{String(i + 1).padStart(2, '0')}</span> {s}</li>)}
              </ol></div>
            )}

            {c.id === 'results' && (
              <dl class="metrics">
                {p.metrics.map((m) => (
                  <div>
                    <dt class="mono muted">{m.label}</dt>
                    <dd class="metric" data-count={m.value} data-decimals={m.decimals} data-prefix={m.prefix ?? ''} data-suffix={m.suffix ?? ''}>{fmt(m)}</dd>
                  </div>
                ))}
              </dl>
            )}
          </section>
        ))}
        {(p.writeup ?? p.repo) && <p class="repo"><a class="btn" href={p.writeup ?? p.repo}>Full write-up on GitHub</a></p>}
      </div>
    </div>
  </section>

  <!-- 4 · next project: the thumbnail morphs into the next case's cover -->
  <section class="case-next light ground">
    <a class="grid next-in" href={`/work/${next.slug}`}>
      <div class="rail"><span class="tick mono" data-tick>Next project</span></div>
      <div class="main next-main">
        <p class="display next-h">{next.title}</p>
        <figure class="next-media dimg" style={`view-transition-name: cover-${next.slug}`}>
          <img src={next.cover} style={next.coverPos && `object-position: ${next.coverPos}`} alt="" width="2560" height="1600" loading="lazy" decoding="async" />
        </figure>
      </div>
    </a>
  </section>
</Base>

<style>
  .case-hero { padding: 150px 0 var(--s5); }
  .case-rail { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s3); padding-top: 12px; }
  .back { color: var(--mute); }
  .case-h { font-size: var(--t-hero); }
  .case-line { margin-top: var(--s4); max-width: 36ch; }
  .chip { margin-top: var(--s3); }
  .meta { margin: var(--s6) 0 0; padding-top: var(--s2); }
  .meta div { grid-column: span 3; border-top: 1px solid var(--line); padding-top: 10px; display: grid; gap: 4px; }
  .meta dd { margin: 0; }

  /* breakout: static state is full bleed; with JS the cover starts clipped to the main column (cols 5-12) */
  .cover-band { padding-bottom: var(--s6); }
  .case-cover { aspect-ratio: 16 / 9; width: 100%; }
  html.js .case-cover { --col: calc((100% - 2 * var(--margin) - 11 * var(--gutter)) / 12);
    clip-path: inset(0 var(--margin) 0 calc(var(--margin) + 4 * (var(--col) + var(--gutter)))); }

  .case-body { padding-bottom: var(--s7); }
  .chapters { position: sticky; top: 110px; align-self: start; }
  .chapters ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .chapters a { display: inline-block; padding: 3px 9px; text-decoration: none; color: var(--mute); transition: color var(--d-s); }
  .chapters a.on { color: var(--ink); }
  .chapter { padding-bottom: var(--s6); scroll-margin-top: 110px; }
  .chapter .body { margin-top: var(--s3); max-width: 60ch; font-size: 19px; line-height: 1.5; }

  .pipe { position: relative; margin-top: var(--s5); }
  .pipe ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n), 1fr); gap: var(--gutter); }
  .pipe-line { position: absolute; left: 6px; right: 6px; top: 5px; height: 1.5px; background: var(--ink); transform-origin: 0 50%; }
  .pipe li { position: relative; padding-top: 26px; display: grid; gap: 2px; }
  .pipe-dot { position: absolute; top: 0; left: 0; width: 12px; height: 12px; background: var(--paper); box-shadow: inset 0 0 0 1.5px var(--ink); }
  .pipe li:last-child .pipe-dot { background: var(--signal); box-shadow: none; }

  .metrics { margin: var(--s5) 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gutter); }
  .metrics div { border-top: 1px solid var(--line); padding-top: 12px; display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 8px; }
  .metric { margin: 0; font: 700 clamp(44px, 5vw, 84px)/.9 var(--sans); letter-spacing: -.045em; font-variant-numeric: tabular-nums; }
  .repo { margin-top: var(--s2); }

  .case-next { padding-block: var(--s6) var(--s7); border-top: 1px solid var(--line); }
  .next-in { text-decoration: none; row-gap: var(--s3); }
  .next-main { display: grid; grid-template-columns: 1fr minmax(0, 46%); gap: var(--gutter); align-items: end; }
  .next-h { font-size: clamp(56px, 8vw, 150px); }
  .next-media { aspect-ratio: 16 / 10; }
  .next-in:hover .next-media { outline: 1.5px solid var(--signal); outline-offset: -1.5px; }

  @media (max-width: 820px) {
    .case-hero { padding-top: 110px; }
    .meta div { grid-column: span 6; }
    html.js .case-cover { clip-path: none; }
    .chapters { display: none; }
    .pipe ol { grid-template-columns: 1fr 1fr; row-gap: var(--s3); } .pipe-line { display: none; }
    .metrics { grid-template-columns: 1fr; }
    .next-main { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { html.js .case-cover { clip-path: none; } }
</style>
